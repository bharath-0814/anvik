# ==============================================================================
# ANVIK — ROOT .GITIGNORE
# Comprehensive exclusion rules for credentials, secrets, build artifacts,
# local database state, virtual environments, and system/editor metadata.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Environment Variables, Secrets & Credentials (NEVER COMMIT)
# ------------------------------------------------------------------------------
.env
.env.*
*.env
*.env.*
.env*.local
.env.local
.env.development.local
.env.test.local
.env.production.local
.env.staging
.env.production

# Whitelist environment template examples ONLY
!.env.example
!*.env.example
!**/.env.example

# Private Keys, Certificates & Cryptographic Material
*.pem
*.key
*.cert
*.crt
*.p12
*.pfx
*.pkcs12
*.ca-bundle
*.der
*.kdbx
id_rsa*
id_dsa*
id_ecdsa*
id_ed25519*
master.key
secring.gpg

# Cloud & Service Account Credentials
*credentials*.json
*credential*.json
*client_secret*.json
*service_account*.json
*service-account*.json
*secret*.json
*secret*.yaml
*secret*.yml
*secret*.toml
*.token
*.secret
secrets.*

# ------------------------------------------------------------------------------
# 2. Cloud Deployments, Serverless & Infrastructure State
# ------------------------------------------------------------------------------
.vercel/
.vercel
**/.vercel/
**/.vercel
.serverless/
.terraform/
*.tfstate
*.tfstate.*
.wrangler/
.aws/
.azure/
.gcloud/
.netlify/

# ------------------------------------------------------------------------------
# 3. Databases, Binary Dumps & Local State
# ------------------------------------------------------------------------------
*.sqlite3
*.sqlite
*.db
*.sqlite3-journal
*.sqlite3-wal
*.sqlite3-shm
*.db-journal
*.db-wal
*.db-shm
*.sql.gz
*.dump
*.rdb
turso_local/
.turso/

# ------------------------------------------------------------------------------
# 4. Python / Backend Build, Cache & Virtual Environments
# ------------------------------------------------------------------------------
__pycache__/
**/__pycache__/
*.py[cod]
*$py.class
*.so
.Python
env/
venv/
.venv/
ENV/
env.bak/
venv.bak/
build/
develop-eggs/
eggs/
lib/
lib64/
parts/
sdist/
var/
wheels/
share/python-wheels/
*.egg-info/
.installed.cfg
*.egg
MANIFEST

# Testing, Linting & Coverage
.pytest_cache/
**/.pytest_cache/
.ruff_cache/
**/.ruff_cache/
.mypy_cache/
**/.mypy_cache/
.coverage
.coverage.*
htmlcov/
coverage/
.hypothesis/

# ------------------------------------------------------------------------------
# 5. Node / Frontend Build & Package Artifacts
# ------------------------------------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
dist-ssr/
**/dist-ssr/
.parcel-cache
.eslintcache
.next/
out/
.nuxt/
.cache/

# ------------------------------------------------------------------------------
# 6. Logs & Diagnostic Traces
# ------------------------------------------------------------------------------
logs/
**/logs/
*.log
*.log.*
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*
.pnpm-debug.log*

# ------------------------------------------------------------------------------
# 7. Temporary Files, Backups & Scratch Directories
# ------------------------------------------------------------------------------
tmp/
**/tmp/
temp/
**/temp/
scratch/
**/scratch/
*.tmp
*.temp
*.bak
*.swp
*.swo
*~
*.old
*.orig

# ------------------------------------------------------------------------------
# 8. Operating System & Editor Metadata
# ------------------------------------------------------------------------------
# macOS
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes

# Windows
Thumbs.db
ehthumbs.db
desktop.ini

# JetBrains / IntelliJ / PyCharm / WebStorm
.idea/
**/.idea/

# Visual Studio Code
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
!.vscode/launch.json

# Visual Studio
*.suo
*.ntvs*
*.njsproj
*.sln

# Cursor / Windsurf / Fleet / Zed
.cursor/
**/.cursor/
.windsurf/
**/.windsurf/
.fleet/
.zed/
.history/

# ------------------------------------------------------------------------------
# 9. Whitelisted Project Datasets (Synthetic Evaluation & Benchmarks)
# ------------------------------------------------------------------------------
!backend/data/
*.zip
*.tar.gz
